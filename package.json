{
  "name": "minecraft-clone",
  "version": "0.29.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "npm run test:unit",
    "test:unit": "tsx --test tests/**/*.test.ts",
    "check": "npm run test:unit && tsc --noEmit && vite build",
    "generate:visual-map": "node scripts/generate-visual-map.mjs",
    "generate:assets": "node scripts/generate-procedural-assets.mjs",
    "audit:items": "node scripts/audit-items-world.mjs",
    "audit:vanilla": "node scripts/audit-vanilla-coverage.mjs",
    "audit:parity": "node scripts/audit-parity.mjs",
    "smoke": "node scripts/smoke/browser-smoke.mjs",
    "smoke:long": "node scripts/smoke/browser-smoke.mjs --scenario new-world --duration 1800",
    "smoke:two-client": "node scripts/smoke/browser-smoke.mjs --scenario two-client",
    "server": "tsx src/server/standalone.ts"
  },
  "dependencies": {
    "@types/ws": "^8.18.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "three": "^0.158.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/three": "^0.158.0",
    "@vitejs/plugin-react": "^4.1.0",
    "playwright": "^1.62.1",
    "tsx": "^4.22.4",
    "typescript": "^5.2.0",
    "vite": "^4.5.0"
  }
}
